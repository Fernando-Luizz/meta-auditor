# Opcional: chave do PageSpeed Insights (recomendada para muitas requisicoes)
# https://developers.google.com/speed/docs/insights/v5/get-started
PSI_API_KEY=

# Opcional: WAVE (WebAIM). Se vazio, POST /audit usa so Lighthouse quando o PSI responder.
# https://wave.webaim.org/api/register
WAVE_API_KEY=
# 4 = itens + seletores CSS (padrao, 3 creditos); 3 = XPath; 2 = so contagens (2 creditos)
WAVE_REPORT_TYPE=4

# Extensao experimental (IA) — desligada por padrao
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

AI_ENHANCE_REPORT=false
AI_ENHANCE_LEVEL=2

# Desenvolvimento: run_dev.ps1 usa porta 8010 por padrao
# $env:META_AUDITOR_PORT=8020

APP_ENV=development
DEBUG=false
MAX_TIMEOUT=90
