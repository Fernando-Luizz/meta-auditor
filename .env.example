# Placeholder values only.
# Obtain and use your own API credentials.
# Never commit a local .env file.

PSI_API_KEY=
WAVE_API_KEY=
ANTHROPIC_API_KEY=

# Optional WAVE report detail (4 = items + CSS selectors; 2 = counts only)
WAVE_REPORT_TYPE=4

# Experimental AI extension — off by default
AI_ENHANCE_REPORT=false
AI_ENHANCE_LEVEL=2

APP_ENV=development
DEBUG=false
MAX_TIMEOUT=90

# HTML/PDF report footer (neutral defaults)
REPORT_FOOTER_ORG=Meta-Auditor
REPORT_FOOTER_AUTHOR=
