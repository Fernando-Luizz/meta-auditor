# Opcional: chave do PageSpeed Insights (recomendada para muitas requisições)
# https://developers.google.com/speed/docs/insights/v5/get-started
PSI_API_KEY=

# Opcional: WAVE (WebAIM). Se vazio, POST /audit usa só Lighthouse quando o PSI responder.
# https://wave.webaim.org/api/register
WAVE_API_KEY=
# 4 = itens + seletores CSS (padrão, 3 créditos); 3 = XPath; 2 = só contagens (2 créditos)
WAVE_REPORT_TYPE=4

# ── EXTENSÃO EXPERIMENTAL (IA) — desligada por defeito / trabalho futuro ─────
#
# O sistema avaliado não depende disto. Com tudo em branco ou false, o
# relatório é o mesmo pipeline Lighthouse + WAVE + normalização.
# Obter chave (só se quiser experimentar): https://console.anthropic.com/
ANTHROPIC_API_KEY=

# false → desativado (defeito no código). true → enriquece texto no relatório
AI_ENHANCE_REPORT=false

# Se ativar: 1 = explicações por barreira; 2 = + ticket / resumo executivo
AI_ENHANCE_LEVEL=2
# ────────────────────────────────────────────────────────────────────────────

# Desenvolvimento: run_dev.ps1 usa porta 8010 por defeito (evita conflito com outro serviço em 8000).
# Para mudar na sessão PowerShell antes de .\run_dev.ps1: $env:META_AUDITOR_PORT=8020

# Sistema
APP_ENV=development
# Em produção mantenha false para não expor caminhos internos do servidor.
# true apenas em desenvolvimento/local para troubleshooting.
DEBUG=false
MAX_TIMEOUT=90
